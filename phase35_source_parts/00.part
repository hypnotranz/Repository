def utc_ms(text: str) -> int:
    return int(datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp() * 1000)


def sha256_file(path: Path, chunk: int = 4 * 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            b = f.read(chunk)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def resolve_inventory() -> list[RemoteFile]:
    r = requests.get(PARQUET_API, timeout=60)
    r.raise_for_status()
    payload = r.json()
    out: list[RemoteFile] = []
    for item in payload.get("parquet_files", []):
        config = str(item.get("config") or item.get("subset") or "")
        if config not in {"depth", "trades", "snapshots"}:
            continue
        url = str(item.get("url") or "")
        if not url:
            continue
        filename = str(item.get("filename") or Path(url).name)
        size = item.get("size")
        out.append(RemoteFile(config, str(item.get("split") or "train"), url, filename, int(size) if isinstance(size, (int, float)) else None))
    if not out:
        raise RuntimeError("no parquet inventory returned")
    return sorted(out, key=lambda x: (x.config, x.filename))


def download_inventory(files: Sequence[RemoteFile], root: Path) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    root.mkdir(parents=True, exist_ok=True)
    session = requests.Session()
    for i, remote in enumerate(files, 1):
        target = root / remote.config / remote.filename
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists() and (remote.size is None or target.stat().st_size == remote.size):
            rows.append({"config": remote.config, "filename": remote.filename, "path": str(target), "bytes": target.stat().st_size, "sha256": sha256_file(target), "cached": True})
            continue
        partial = target.with_suffix(target.suffix + ".partial")
        partial.unlink(missing_ok=True)
        print(f"[{i}/{len(files)}] download {remote.config}/{remote.filename}", flush=True)
        with session.get(remote.url, stream=True, timeout=(30, 600)) as r:
            r.raise_for_status()
            with partial.open("wb") as f:
                for chunk in r.iter_content(8 * 1024 * 1024):
                    if chunk:
                        f.write(chunk)
        if remote.size is not None and partial.stat().st_size != remote.size:
            raise RuntimeError(f"size mismatch {remote.filename}: {partial.stat().st_size} != {remote.size}")
        os.replace(partial, target)
        rows.append({"config": remote.config, "filename": remote.filename, "path": str(target), "bytes": target.stat().st_size, "sha256": sha256_file(target), "cached": False})
    return rows


def quote_sql_path(path: Path) -> str:
    return str(path).replace("'", "''")


def parquet_glob(root: Path, config: str) -> str:
    return quote_sql_path(root / config / "*.parquet")


def get_time_inventory(con: duckdb.DuckDBPyConnection, root: Path) -> pd.DataFrame:
    parts = []
    for config in ("depth", "trades", "snapshots"):
        path = parquet_glob(root, config)
        q = f"""
        SELECT '{config}' AS config, asset, min(timestamp_ms) AS min_ts,
               max(timestamp_ms) AS max_ts, count(*) AS rows
        FROM read_parquet('{path}') GROUP BY asset ORDER BY asset
        """
        parts.append(con.execute(q).fetch_df())
    return pd.concat(parts, ignore_index=True)


def load_snapshot(con: duckdb.DuckDBPyConnection, root: Path, asset: str, start_ms: int) -> tuple[pd.DataFrame, int, int]:
    snapshot_path = parquet_glob(root, "snapshots")
    depth_path = parquet_glob(root, "depth")
    ts_row = con.execute(
        f"SELECT max(timestamp_ms) FROM read_parquet('{snapshot_path}') WHERE asset=? AND timestamp_ms<=?",
        [asset, start_ms],
    ).fetchone()
